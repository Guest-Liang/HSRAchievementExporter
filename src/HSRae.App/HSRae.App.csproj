<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>Exe</OutputType>
    <AssemblyName>HSRae</AssemblyName>
    <RootNamespace>HSRae.App</RootNamespace>
    <AssemblyTitle>HSRae 崩坏：星穹铁道成就导出工具</AssemblyTitle>
    <Product>HSRae</Product>
    <Company>GuestLiang</Company>
    <Copyright>Copyright © 2026 GuestLiang</Copyright>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <TargetExt Condition="'$(UseExecutableManagedTargetForNativeAot)' == 'true'">.exe</TargetExt>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PublishAot>true</PublishAot>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <InvariantGlobalization>true</InvariantGlobalization>
    <OptimizationPreference>Size</OptimizationPreference>
    <DebugSymbols>false</DebugSymbols>
    <DebugType>none</DebugType>
    <StripSymbols>true</StripSymbols>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\HSRae.Core\HSRae.Core.csproj" />
    <ProjectReference Include="..\HSRae.Formats\HSRae.Formats.csproj" />
    <ProjectReference Include="..\HSRae.Protocol\HSRae.Protocol.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(HookBinaryPath)' != '' and Exists('$(HookBinaryPath)')">
    <EmbeddedResource Include="$(HookBinaryPath)" LogicalName="HSRae.Hook.dll" />
  </ItemGroup>

  <Target
    Name="ValidateEmbeddedHook"
    BeforeTargets="PrepareForPublish"
    Condition="'$(RequireEmbeddedHook)' == 'true'"
  >
    <Error
      Condition="'$(HookBinaryPath)' == ''"
      Text="HookBinaryPath must point to the published NativeAOT hook library."
    />
    <Error
      Condition="!Exists('$(HookBinaryPath)')"
      Text="The hook library was not found at '$(HookBinaryPath)'."
    />
  </Target>
</Project>
